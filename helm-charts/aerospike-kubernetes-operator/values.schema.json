{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "operatorImage",
        "rbac",
        "healthPort",
        "metricsPort",
        "certs",
        "logging",
        "metrics",
        "safePodEviction",
        "metricsService",
        "webhookService"
    ],
    "properties": {
        "aerospikeKubernetesInitNameTag": {
            "description": "Name and tag of aerospike-init image",
            "type": [
                "string",
                "null"
            ]
        },
        "aerospikeKubernetesInitRegistry": {
            "description": "Registry used to pull aerospike-init image",
            "type": [
                "string",
                "null"
            ]
        },
        "aerospikeKubernetesInitRegistryNamespace": {
            "description": "Namespace in registry used to pull aerospike-init image",
            "type": [
                "string",
                "null"
            ]
        },
        "certs": {
            "description": "Certificate configuration for the webhook and metrics endpoints",
            "type": "object",
            "required": [
                "webhook",
                "metrics"
            ],
            "properties": {
                "metrics": {
                    "description": "Metrics server certificate configuration",
                    "allOf": [
                        {
                            "type": "object"
                        },
                        {
                            "if": {
                                "required": [
                                    "create"
                                ],
                                "properties": {
                                    "create": {
                                        "const": true
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "metricsServerCertSecretName"
                                ],
                                "properties": {
                                    "metricsServerCertSecretName": {
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    ],
                    "properties": {
                        "create": {
                            "type": [
                                "boolean",
                                "string",
                                "null"
                            ]
                        },
                        "metricsServerCertSecretName": {
                            "description": "Name of the secret holding the metrics server certificate",
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "webhook": {
                    "description": "Webhook server certificate configuration",
                    "allOf": [
                        {
                            "type": "object"
                        },
                        {
                            "if": {
                                "required": [
                                    "provider"
                                ],
                                "properties": {
                                    "provider": {
                                        "const": "external"
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "external"
                                ],
                                "properties": {
                                    "external": {
                                        "required": [
                                            "caBundle"
                                        ],
                                        "properties": {
                                            "caBundle": {
                                                "minLength": 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    ],
                    "required": [
                        "webhookServerCertSecretName"
                    ],
                    "properties": {
                        "certManager": {
                            "description": "Reserved for future cert-manager tuning (issuerRef, duration, renewBefore)",
                            "type": "object",
                            "additionalProperties": false
                        },
                        "create": {
                            "description": "DEPRECATED: use `provider` instead. Only consulted when `provider` is empty. Will be removed in a future release.",
                            "type": [
                                "boolean",
                                "string",
                                "null"
                            ]
                        },
                        "external": {
                            "type": "object",
                            "properties": {
                                "caBundle": {
                                    "description": "Base64-encoded PEM CA bundle that signed the webhook serving certificate (not the serving certificate itself). Required when provider is external. Surrounding and embedded whitespace is stripped before rendering, so wrapped output and a trailing newline are fine — reading it from a `base64` file works. A whitespace-only value is rejected: it would strip to empty and silently render a webhook config with no caBundle.",
                                    "type": "string",
                                    "pattern": "^(|\\s*[A-Za-z0-9+/][A-Za-z0-9+/\\s]*={0,2}\\s*)$"
                                }
                            },
                            "additionalProperties": false
                        },
                        "provider": {
                            "description": "How the webhook serving certificate is provided. certManager: chart creates the cert-manager Issuer/Certificate (requires cert-manager). selfSigned: chart generates the cert and Secret itself. Dev/POC only, see README. external: you pre-create the Secret and supply external.caBundle. Empty infers the mode from the deprecated `create` flag (4.5.0 compatibility).",
                            "type": "string",
                            "enum": [
                                "",
                                "certManager",
                                "selfSigned",
                                "external"
                            ]
                        },
                        "selfSigned": {
                            "description": "Reserved for future self-signed tuning (duration). Dev/POC only",
                            "type": "object",
                            "additionalProperties": false
                        },
                        "webhookServerCertSecretName": {
                            "description": "Name of the secret holding the webhook server certificate",
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "additionalProperties": false
                }
            }
        },
        "extraEnv": {
            "description": "Extra environment variables that will be passed into the operator pods",
            "anyOf": [
                {
                    "type": [
                        "object",
                        "null"
                    ]
                },
                {
                    "type": "array"
                }
            ]
        },
        "failedPodGracePeriodSeconds": {
            "description": "Grace period to delete/recover failed pods (in seconds)",
            "type": [
                "string",
                "number",
                "null"
            ]
        },
        "fullnameOverride": {
            "description": "Override the fully qualified name used for generated resource names",
            "type": [
                "string",
                "null"
            ]
        },
        "healthPort": {
            "description": "Port for the operator's health probe bind address",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "integer"
                }
            ]
        },
        "ignoreNamespaces": {
            "description": "Comma-separated list of namespaces to ignore. Only used for eviction webhook",
            "type": [
                "string",
                "null"
            ]
        },
        "imagePullSecrets": {
            "description": "In case the above image is pulled from a registry that requires authentication, a secret containing credentials can be added imagePullSecrets: - secret_with_credentials_to_custom_registry",
            "anyOf": [
                {
                    "type": "array"
                },
                {
                    "type": "object"
                },
                {
                    "type": "null"
                }
            ]
        },
        "logging": {
            "description": "Operator manager logging (controller-runtime / Zap). `development` must stay set; level/encoder are optional (set them in values or on the CLI).",
            "type": "object",
            "required": [
                "development"
            ],
            "properties": {
                "development": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            }
        },
        "metrics": {
            "description": "Operator manager /metrics endpoint configuration Always passed in the Deployment args for clarity; defaults to TLS on (`true`).",
            "type": "object",
            "required": [
                "secure"
            ],
            "properties": {
                "secure": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "additionalProperties": false
        },
        "metricsPort": {
            "description": "Port for the operator's metrics bind address",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "integer"
                }
            ]
        },
        "metricsService": {
            "description": "Service configuration",
            "type": "object",
            "required": [
                "port"
            ],
            "properties": {
                "port": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ]
                },
                "type": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "nameOverride": {
            "description": "Override the chart name used in generated resource names",
            "type": [
                "string",
                "null"
            ]
        },
        "operatorImage": {
            "description": "Operator image",
            "type": "object",
            "required": [
                "repository",
                "tag"
            ],
            "properties": {
                "pullPolicy": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "repository": {
                    "type": "string",
                    "minLength": 1
                },
                "tag": {
                    "type": [
                        "string",
                        "number"
                    ],
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "rbac": {
            "description": "RBAC resource creation for the operator",
            "type": "object",
            "properties": {
                "create": {
                    "description": "Create RBAC resources and a service account for the operator",
                    "type": [
                        "boolean",
                        "string",
                        "null"
                    ]
                }
            }
        },
        "replicas": {
            "description": "Number of operator replicas to deploy",
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ]
        },
        "safePodEviction": {
            "description": "Enable the eviction webhook to safely block Aerospike pod evictions during node maintenance Also enables Prometheus metrics: aerospike_ako_eviction_webhook_requests_total (labels: eviction_namespace, decision)",
            "type": "object",
            "properties": {
                "enable": {
                    "type": [
                        "boolean",
                        "string",
                        "null"
                    ]
                },
                "timeoutSeconds": {
                    "type": [
                        "string",
                        "number",
                        "null"
                    ]
                }
            },
            "additionalProperties": false
        },
        "watchNamespaces": {
            "description": "Comma-separated list of namespaces to watch for Aerospike custom resources",
            "type": [
                "string",
                "null"
            ]
        },
        "webhookService": {
            "description": "Service configuration",
            "type": "object",
            "required": [
                "port",
                "targetPort"
            ],
            "properties": {
                "port": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ]
                },
                "targetPort": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ]
                },
                "type": {
                    "description": "Kubernetes Service type",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    },
    "additionalProperties": true
}
